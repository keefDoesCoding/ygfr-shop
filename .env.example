# Copy to .env.local for local testing with real services (optional).
# Without these, `npm run dev` uses local stand-ins for storage and Stripe.

# Password for /admin
ADMIN_PASSWORD=
# Any long random string; keeps admin sign-in cookies secure
SESSION_SECRET=

# Stripe (Dashboard > Developers > API keys). Use sk_test_ first, sk_live_ when launching.
STRIPE_SECRET_KEY=
# Stripe (Dashboard > Developers > Webhooks > your endpoint > Signing secret)
STRIPE_WEBHOOK_SECRET=

# Added automatically on Vercel when you connect Upstash for Redis
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: your public address, e.g. https://yourgirlsfavourite.co.nz
SITE_URL=
